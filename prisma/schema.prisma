datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Link {
  id           Int      @id @default(autoincrement())
  url          String   @unique
  mdStatus     String   @default("pending")
  uploadStatus String   @default("pending")
  error        String?
  createdAt    DateTime @default(now())
}
